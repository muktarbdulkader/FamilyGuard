<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6000000"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@android:color/white">

            <!-- Top Row: Close button -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/overlay_close"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="end|top"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel" />
            </FrameLayout>

            <!-- Warning/Alert icon -->
            <ImageView
                android:id="@+id/overlay_icon"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:src="@android:drawable/ic_dialog_alert"
                android:tint="@color/accent_color" />

            <!-- Title -->
            <TextView
                android:id="@+id/overlay_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="App Restricted"
                android:textColor="#1F2937"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Message -->
            <TextView
                android:id="@+id/overlay_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:text="This app is not available right now. Please choose a different activity."
                android:textColor="#6B7280"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <!-- Status Container (Visible when request is pending or sent) -->
            <LinearLayout
                android:id="@+id/overlay_status_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#FEF3C7"
                android:paddingVertical="10dp"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/overlay_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏳ Request Sent! Waiting for parent..."
                    android:textColor="#B45309"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Primary Action Button (Ask Parent) -->
            <Button
                android:id="@+id/overlay_action"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/button_background"
                android:text="Ask Parent"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                android:layout_marginBottom="10dp" />

            <!-- Secondary Action Button (Close App) -->
            <Button
                android:id="@+id/overlay_secondary_action"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/button_secondary"
                android:text="Close App"
                android:textColor="@color/accent_color"
                android:textSize="15sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                android:layout_marginBottom="4dp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>