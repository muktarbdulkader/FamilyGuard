rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for authentication and authorization
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getFamilyData(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data;
    }
    
    function isParentInFamily(familyId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/families/$(familyId)) &&
             getFamilyData(familyId).parentIds.hasAny([request.auth.uid]);
    }
    
    function isChildInFamily(familyId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/families/$(familyId)) &&
             getFamilyData(familyId).childIds.hasAny([request.auth.uid]);
    }
    
    function isFamilyMember(familyId) {
      return isParentInFamily(familyId) || isChildInFamily(familyId);
    }
    
    function isValidTimestamp(timestamp) {
      return timestamp is timestamp && 
             timestamp <= request.time &&
             timestamp >= request.time - duration.value(300, 's'); // Max 5 minutes ago
    }
    
    function isValidCoordinates(lat, lng) {
      return lat is number && lng is number &&
             lat >= -90 && lat <= 90 &&
             lng >= -180 && lng <= 180;
    }
    
    // USERS COLLECTION - Strict user isolation
    match /users/{userId} {
      allow read, write: if isUser(userId);
      
      // Prevent role escalation and family manipulation
      allow update: if isUser(userId) &&
                   // Cannot change role after creation
                   (!('role' in request.resource.data.diff(resource.data).addedKeys()) ||
                    request.resource.data.role == resource.data.role) &&
                   // Cannot directly modify familyId (must go through family join process)
                   (!('familyId' in request.resource.data.diff(resource.data).changedKeys()) ||
                    request.resource.data.familyId == resource.data.familyId);
    }
    
    // FAMILIES COLLECTION - Critical authorization controls
    match /families/{familyId} {
      // CRITICAL: Only family members can read, only parents can write
      allow read: if isAuthenticated() && isFamilyMember(familyId);
      
      // CRITICAL: Only parents can create/update family
      allow create: if isAuthenticated() &&
                   request.resource.data.parentIds.hasAny([request.auth.uid]) &&
                   // Ensure creator is in parentIds
                   request.resource.data.parentIds.size() >= 1 &&
                   // Prevent creating family with existing children without proper process
                   request.resource.data.childIds.size() == 0;
      
      allow update: if isAuthenticated() && 
                   isParentInFamily(familyId) &&
                   // Prevent parents from being removed
                   request.resource.data.parentIds.hasAny(resource.data.parentIds) &&
                   // Ensure at least one parent remains
                   request.resource.data.parentIds.size() >= 1;
      
      // CRITICAL: Prevent unauthorized family deletion
      allow delete: if false; // Families should not be deleted, only archived
      
      // CHILDREN SUBCOLLECTION - Child-specific data and rules
      match /children/{childId} {
        // CRITICAL: Only parents can read all child data, children can read own data
        allow read: if isAuthenticated() && 
                   (isParentInFamily(familyId) || request.auth.uid == childId);
        
        // CRITICAL: Only parents can write child configuration
        allow write: if isAuthenticated() && isParentInFamily(familyId);
        
        // APP RULES - Critical for enforcement security  
        match /apps/{packageName} {
          // CRITICAL: Children can read their rules, parents can read/write
          allow read: if isAuthenticated() && 
                     (isParentInFamily(familyId) || request.auth.uid == childId);
          
          // CRITICAL: Only parents can set app rules
          allow create, update: if isAuthenticated() && 
                               isParentInFamily(familyId) &&
                               // Validate rule structure to prevent malicious rules
                               request.resource.data.keys().hasAll(['packageName', 'rule', 'updatedAt']) &&
                               request.resource.data.packageName == packageName &&
                               request.resource.data.rule in ['allowed', 'blocked', 'ask_parent', 'time_limit'] &&
                               // Validate time limits are reasonable
                               (request.resource.data.rule != 'time_limit' || 
                                (request.resource.data.dailyLimitMinutes >= 1 && 
                                 request.resource.data.dailyLimitMinutes <= 1440)) && // 1 min to 24 hours
                               isValidTimestamp(request.resource.data.updatedAt);
          
          allow delete: if isAuthenticated() && isParentInFamily(familyId);
        }
        
        // USAGE DATA - Track app usage securely
        match /usage/{packageName} {
          // CRITICAL: Only child can update their usage, parents can read
          allow read: if isAuthenticated() && 
                     (isParentInFamily(familyId) || request.auth.uid == childId);
          
          allow create, update: if isAuthenticated() && 
                               request.auth.uid == childId &&
                               isChildInFamily(familyId) &&
                               // Validate usage data structure
                               request.resource.data.keys().hasAll(['packageName', 'usedMinutes', 'lastUpdated']) &&
                               request.resource.data.packageName == packageName &&
                               request.resource.data.usedMinutes is number &&
                               request.resource.data.usedMinutes >= 0 &&
                               request.resource.data.usedMinutes <= 1440 && // Max 24 hours per day
                               isValidTimestamp(request.resource.data.lastUpdated);
        }
        
        // LOCATION DATA - Secure location sharing
        match /locations/{locationId} {
          // CRITICAL: Parents can read, only child can create their locations
          allow read: if isAuthenticated() && 
                     (isParentInFamily(familyId) || request.auth.uid == childId);
          
          allow create: if isAuthenticated() && 
                       request.auth.uid == childId &&
                       isChildInFamily(familyId) &&
                       // Validate location data
                       request.resource.data.keys().hasAll(['familyId', 'childId', 'latitude', 'longitude', 'timestamp']) &&
                       request.resource.data.familyId == familyId &&
                       request.resource.data.childId == childId &&
                       isValidCoordinates(request.resource.data.latitude, request.resource.data.longitude) &&
                       isValidTimestamp(request.resource.data.timestamp) &&
                       // Prevent excessive location updates (max 1 per minute)
                       (!exists(/databases/$(database)/documents/families/$(familyId)/children/$(childId)/locations/$(locationId)) ||
                        request.resource.data.timestamp > resource.data.timestamp + duration.value(60, 's'));
          
          // CRITICAL: Locations are immutable once created
          allow update, delete: if false;
        }
        
        // REQUEST SYSTEM - CRITICAL security for approval workflow
        match /requests/{requestId} {
          // CRITICAL: Prevent request tampering and unauthorized access
          allow read: if isAuthenticated() && 
                     (isParentInFamily(familyId) || request.auth.uid == childId);
          
          // CRITICAL: Only children can create requests for themselves
          allow create: if isAuthenticated() && 
                       request.auth.uid == childId &&
                       isChildInFamily(familyId) &&
                       // Strict request validation
                       request.resource.data.keys().hasAll([
                         'requestId', 'familyId', 'childId', 'packageName', 'appName', 
                         'status', 'createdAt', 'expiresAt', 'requestNonce'
                       ]) &&
                       request.resource.data.requestId == requestId &&
                       request.resource.data.familyId == familyId &&
                       request.resource.data.childId == childId &&
                       request.resource.data.status == 'pending' &&
                       // Prevent future timestamps (clock manipulation)
                       request.resource.data.createdAt <= request.time &&
                       // Reasonable expiry (max 15 minutes, min 1 minute)
                       request.resource.data.expiresAt <= request.time + duration.value(900, 's') &&
                       request.resource.data.expiresAt >= request.time + duration.value(60, 's') &&
                       // Prevent XSS in app names
                       request.resource.data.appName.size() <= 50 &&
                       request.resource.data.packageName.size() <= 100 &&
                       request.resource.data.packageName.matches('^[a-zA-Z0-9._]+$') &&
                       // Unique nonce to prevent replay attacks
                       request.resource.data.requestNonce is string &&
                       request.resource.data.requestNonce.size() == 32;
          
          // CRITICAL: Children can only cancel their own pending requests
          allow update: if isAuthenticated() && 
                       request.auth.uid == childId &&
                       isChildInFamily(familyId) &&
                       resource.data.status == 'pending' &&
                       request.resource.data.status == 'cancelled' &&
                       // Only allow changing status and timestamp
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'cancelledAt']) &&
                       request.resource.data.cancelledAt <= request.time;
          
          // CRITICAL: NO direct approval/denial by parents in Firestore
          // All approvals MUST go through Cloud Functions for security validation
          
          allow delete: if false; // Requests should never be deleted
        }
        
        // TEMPORARY APPROVALS - Secure time-limited access
        match /approvals/{approvalId} {
          // CRITICAL: Read-only for children, managed by Cloud Functions
          allow read: if isAuthenticated() && 
                     (isParentInFamily(familyId) || request.auth.uid == childId);
          
          // CRITICAL: Only Cloud Functions can create/update approvals
          // This prevents client-side approval manipulation
          allow write: if false; // Only server-side via Cloud Functions
        }
      }
    }
    
    // FAMILY INVITES - Secure pairing process
    match /family_invites/{inviteCode} {
      // Anyone authenticated can read to join families
      allow read: if isAuthenticated() &&
                 // Only allow reading active, non-expired invites
                 resource.data.expiresAt > request.time &&
                 resource.data.isUsed == false;
      
      // Only parents can create invites
      allow create: if isAuthenticated() &&
                   request.resource.data.parentId == request.auth.uid &&
                   // Validate invite structure
                   request.resource.data.keys().hasAll([
                     'familyId', 'parentId', 'createdAt', 'expiresAt', 'isUsed'
                   ]) &&
                   isValidTimestamp(request.resource.data.createdAt) &&
                   // Reasonable expiry (max 1 hour, min 1 minute)
                   request.resource.data.expiresAt <= request.time + duration.value(3600, 's') &&
                   request.resource.data.expiresAt >= request.time + duration.value(60, 's') &&
                   request.resource.data.isUsed == false;
      
      // Only creator can update (mark as used)
      allow update: if isAuthenticated() && 
                   request.auth.uid == resource.data.parentId &&
                   // Only allow marking as used
                   request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['isUsed', 'usedAt', 'usedBy']) &&
                   request.resource.data.isUsed == true;
      
      allow delete: if isAuthenticated() && 
                   request.auth.uid == resource.data.parentId;
    }
    
    // NOTIFICATIONS - Secure notification system
    match /notifications/{notificationId} {
      // CRITICAL: Only parents can read family notifications
      allow read: if isAuthenticated() && 
                 resource.data.familyId != null &&
                 isParentInFamily(resource.data.familyId);
      
      // CRITICAL: Only children and Cloud Functions can create notifications
      allow create: if isAuthenticated() &&
                   request.resource.data.familyId != null &&
                   isFamilyMember(request.resource.data.familyId) &&
                   // Validate notification structure
                   request.resource.data.keys().hasAll([
                     'familyId', 'childId', 'type', 'title', 'body', 'createdAt'
                   ]) &&
                   isValidTimestamp(request.resource.data.createdAt) &&
                   // Prevent XSS in notification content
                   request.resource.data.title.size() <= 100 &&
                   request.resource.data.body.size() <= 500;
      
      // CRITICAL: Only parents can mark as read
      allow update: if isAuthenticated() && 
                   resource.data.familyId != null &&
                   isParentInFamily(resource.data.familyId) &&
                   // Only allow updating read status
                   request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['isRead', 'readAt']) &&
                   request.resource.data.isRead == true;
      
      allow delete: if false; // Notifications should not be deleted
    }
    
    // FCM TOKENS - Secure token management
    match /fcm_tokens/{tokenId} {
      // CRITICAL: Users can only access their own tokens
      allow read, write: if isAuthenticated() && 
                        resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() && 
                   request.resource.data.userId == request.auth.uid &&
                   // Validate token structure
                   request.resource.data.keys().hasAll(['userId', 'token', 'platform', 'createdAt']) &&
                   request.resource.data.token.size() > 10 && // Valid FCM token length
                   request.resource.data.platform in ['android', 'ios', 'web'] &&
                   isValidTimestamp(request.resource.data.createdAt);
    }
    
    // DEVICE STATUS - Monitoring status tracking
    match /device_status/{statusId} {
      allow read: if isAuthenticated();
      
      allow create, update: if isAuthenticated() && 
                           request.resource.data.childId == request.auth.uid &&
                           // Validate status data
                           request.resource.data.keys().hasAll(['childId', 'timestamp']) &&
                           isValidTimestamp(request.resource.data.timestamp);
    }
    
    // AUDIT LOGS - Security monitoring (Cloud Functions only)
    match /auditLogs/{logId} {
      // CRITICAL: Only Cloud Functions can write audit logs
      allow read: if false; // Admin only (implement admin check if needed)
      allow write: if false; // Only Cloud Functions via Admin SDK
    }
    
    // LOCATION SETTINGS - Family location sharing controls
    match /families/{familyId}/settings/location_sharing {
      allow read: if isAuthenticated() && isFamilyMember(familyId);
      
      // CRITICAL: Only parents can enable/configure location sharing
      allow write: if isAuthenticated() && isParentInFamily(familyId) &&
                  // Validate settings structure
                  request.resource.data.keys().hasAll(['isEnabled', 'enabledBy']) &&
                  request.resource.data.enabledBy == request.auth.uid;
    }
    
    // DEFAULT DENY - CRITICAL security measure
    match /{document=**} {
      allow read, write: if false;
    }
  }
}