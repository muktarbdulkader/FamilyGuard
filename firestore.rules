rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - users can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Families collection
    match /families/{familyId} {
      // Allow read/write if user is the parent of the family
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.parentId || 
         request.auth.uid in resource.data.childrenIds);
      
      // Allow create if user is authenticated (for new families)
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.parentId;
      
      // Children subcollection
      match /children/{childId} {
        // Parents can read/write all children data
        // Children can only read/write their own data
        allow read, write: if request.auth != null && 
          (request.auth.uid == get(/databases/$(database)/documents/families/$(familyId)).data.parentId ||
           request.auth.uid == childId);
        
        // Apps subcollection
        match /apps/{appId} {
          // Parents can read/write all app rules
          // Children can only read their own app rules
          allow read: if request.auth != null && 
            (request.auth.uid == get(/databases/$(database)/documents/families/$(familyId)).data.parentId ||
             request.auth.uid == childId);
          allow write: if request.auth != null && 
            request.auth.uid == get(/databases/$(database)/documents/families/$(familyId)).data.parentId;
        }
        
        // Requests subcollection
        match /requests/{requestId} {
          // Parents can read/write all requests
          // Children can read/write only their own requests
          allow read: if request.auth != null && 
            (request.auth.uid == get(/databases/$(database)/documents/families/$(familyId)).data.parentId ||
             request.auth.uid == childId);
          allow create: if request.auth != null && request.auth.uid == childId;
          allow update: if request.auth != null && 
            (request.auth.uid == get(/databases/$(database)/documents/families/$(familyId)).data.parentId ||
             (request.auth.uid == childId && 
              request.resource.data.status == resource.data.status)); // Children can't change status
        }
        
        // Locations subcollection
        match /locations/{locationId} {
          // Parents can read all locations
          // Children can only write their own location
          allow read: if request.auth != null && 
            request.auth.uid == get(/databases/$(database)/documents/families/$(familyId)).data.parentId;
          allow write: if request.auth != null && request.auth.uid == childId;
        }
      }
    }
    
    // Family invites collection
    match /family_invites/{inviteCode} {
      // Anyone can read valid invites (to join family)
      allow read: if request.auth != null && 
        resource.data.expiresAt > request.time && 
        !resource.data.isUsed;
      
      // Only parents can create invites
      allow create: if request.auth != null;
      
      // Only system can update (mark as used)
      allow update: if request.auth != null;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}