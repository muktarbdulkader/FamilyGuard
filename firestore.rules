rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }
    
    // FAMILIES COLLECTION & ALL NESTED SUBCOLLECTIONS
    // Covers: children, apps, usage, locations, requests, approvals, education_tasks, notifications, events
    match /families/{familyId} {
      allow read, write: if isAuthenticated();
      
      // Children subcollection and all nested paths (apps, usage, locations, requests, education_tasks, temporaryApprovals)
      match /children/{childId} {
        allow read, write: if isAuthenticated();
        
        match /{childSubcollection=**} {
          allow read, write: if isAuthenticated();
        }
      }

      // Explicit match for study & education tasks
      match /education_tasks/{taskId} {
        allow read, write: if isAuthenticated();
      }

      // Match all other family subcollections (notifications, requests, etc.)
      match /{allFamilyDocs=**} {
        allow read, write: if isAuthenticated();
      }
    }
    
    // TOP-LEVEL EDUCATION TASKS
    match /education_tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    // FAMILY INVITES COLLECTION
    match /family_invites/{inviteCode} {
      allow read, write: if isAuthenticated();
    }
    
    // NOTIFICATIONS COLLECTION
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }
    
    // FCM TOKENS COLLECTION
    match /fcm_tokens/{tokenId} {
      allow read, write: if isAuthenticated();
    }
    
    // DEVICE STATUS COLLECTION
    match /device_status/{statusId} {
      allow read, write: if isAuthenticated();
    }

    // RULES & LOGS COLLECTIONS
    match /rules/{ruleId} {
      allow read, write: if isAuthenticated();
    }

    match /rule_enforcement_logs/{logId} {
      allow read, write: if isAuthenticated();
    }
    
    // CATCH-ALL FOR ALL OTHER AUTHENTICATED ACCESS
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}