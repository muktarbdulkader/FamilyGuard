rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isUser(userId);
      allow delete: if false;
    }
    
    // FAMILIES COLLECTION
    match /families/{familyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
      
      // CHILDREN SUBCOLLECTION & ALL SUBCOLLECTIONS (apps, usage, locations, requests, approvals)
      match /children/{childId} {
        allow read, write: if isAuthenticated();
        
        match /{allChildrenDocs=**} {
          allow read, write: if isAuthenticated();
        }
      }

      match /{allFamilyDocs=**} {
        allow read, write: if isAuthenticated();
      }
    }
    
    // FAMILY INVITES COLLECTION
    match /family_invites/{inviteCode} {
      allow read, write: if isAuthenticated();
    }
    
    // NOTIFICATIONS COLLECTION
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }
    
    // FCM TOKENS COLLECTION
    match /fcm_tokens/{tokenId} {
      allow read, write: if isAuthenticated();
    }
    
    // DEVICE STATUS COLLECTION
    match /device_status/{statusId} {
      allow read, write: if isAuthenticated();
    }

    // RULES COLLECTION
    match /rules/{ruleId} {
      allow read, write: if isAuthenticated();
    }

    // RULE ENFORCEMENT LOGS
    match /rule_enforcement_logs/{logId} {
      allow read, write: if isAuthenticated();
    }
    
    // DEFAULT DENY FOR UNMATCHED PATHS
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}