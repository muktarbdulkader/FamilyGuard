rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection rules
    match /users/{userId} {
      // Only authenticated users can read/write their own document
      allow read, write: if request.auth != null 
        && request.auth.uid == userId;
      
      // Prevent role tampering - only allow role changes through server functions
      // or with proper validation
      allow update: if request.auth != null 
        && request.auth.uid == userId
        && validateUserUpdate();
    }
    
    // Helper function to validate user document updates
    function validateUserUpdate() {
      let incomingData = request.resource.data;
      let existingData = resource.data;
      
      return (
        // Required fields must be present
        incomingData.keys().hasAll(['uid', 'email', 'displayName', 'role', 'updatedAt']) &&
        
        // UID and email cannot be changed
        incomingData.uid == existingData.uid &&
        incomingData.email == existingData.email &&
        
        // Role must be valid
        incomingData.role in ['parent', 'child', 'none'] &&
        
        // UpdatedAt must be a timestamp and in the future
        incomingData.updatedAt is timestamp &&
        incomingData.updatedAt > existingData.updatedAt &&
        
        // DisplayName must be a string and not empty
        incomingData.displayName is string &&
        incomingData.displayName.size() > 0 &&
        incomingData.displayName.size() <= 100
      );
    }
    
    // Family collections (for future implementation)
    match /families/{familyId} {
      // Allow read/write for authenticated family members
      allow read, write: if request.auth != null 
        && request.auth.uid in resource.data.memberIds;
    }
    
    // App restrictions (for future implementation) 
    match /appRestrictions/{userId} {
      // Only the user and their parent can read restrictions
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isParentOf(request.auth.uid, userId)
      );
      
      // Only parents can write restrictions
      allow write: if request.auth != null && 
        isParentOf(request.auth.uid, userId);
    }
    
    // Location data (for future implementation)
    match /locations/{userId} {
      // Only the user and their parent can read location
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isParentOf(request.auth.uid, userId)
      );
      
      // Only the user can write their own location
      allow write: if request.auth != null && 
        request.auth.uid == userId;
    }
    
    // Helper function to check if user is parent of target
    function isParentOf(parentId, childId) {
      // This would need to be implemented based on family structure
      // For now, return false to be secure by default
      return false;
    }
    
    // Default rule - deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}