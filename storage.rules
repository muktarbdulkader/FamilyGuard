rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function familyPath(familyId) {
      return /databases/(default)/documents/families/$(familyId);
    }

    function familyMember(familyId) {
      return signedIn() &&
        firestore.exists(familyPath(familyId)) &&
        (
          (
            'parentIds' in firestore.get(familyPath(familyId)).data &&
            firestore.get(familyPath(familyId)).data.parentIds is list &&
            firestore.get(familyPath(familyId)).data.parentIds.hasAny([request.auth.uid])
          ) ||
          (
            'parentId' in firestore.get(familyPath(familyId)).data &&
            firestore.get(familyPath(familyId)).data.parentId == request.auth.uid
          ) ||
          (
            'childIds' in firestore.get(familyPath(familyId)).data &&
            firestore.get(familyPath(familyId)).data.childIds is list &&
            firestore.get(familyPath(familyId)).data.childIds.hasAny([request.auth.uid])
          ) ||
          (
            'childrenIds' in firestore.get(familyPath(familyId)).data &&
            firestore.get(familyPath(familyId)).data.childrenIds is list &&
            firestore.get(familyPath(familyId)).data.childrenIds.hasAny([request.auth.uid])
          )
        );
    }

    function familyParent(familyId) {
      return signedIn() &&
        firestore.exists(familyPath(familyId)) &&
        (
          (
            'parentIds' in firestore.get(familyPath(familyId)).data &&
            firestore.get(familyPath(familyId)).data.parentIds is list &&
            firestore.get(familyPath(familyId)).data.parentIds.hasAny([request.auth.uid])
          ) ||
          (
            'parentId' in firestore.get(familyPath(familyId)).data &&
            firestore.get(familyPath(familyId)).data.parentId == request.auth.uid
          )
        );
    }

    match /families/{familyId}/education/{allPaths=**} {
      allow read: if familyMember(familyId);
      allow create, update: if familyParent(familyId) &&
        request.resource.size < 100 * 1024 * 1024;
      allow delete: if familyParent(familyId);
    }

    match /users/{userId}/{allPaths=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
